generator client { provider = "prisma-client" output = "../src/generated/prisma" }
datasource db { provider = "postgresql" }
enum VerificationState { VERIFIED PARTIALLY_VERIFIED INFERRED UNKNOWN REQUIRES_VERIFICATION }
enum LeadStage { RESEARCH VERIFIED QUALIFIED CONTACTED ENGAGED MEETING OPPORTUNITY NEGOTIATION WON LOST }
enum MessageState { DRAFT APPROVED SCHEDULED SENT DELIVERED FAILED REJECTED SUPPRESSED }
model Organization { id String @id @default(uuid()) name String users User[] companies Company[] campaigns Campaign[] createdAt DateTime @default(now()) }
model User { id String @id @default(uuid()) organizationId String organization Organization @relation(fields:[organizationId],references:[id]) email String displayName String role String active Boolean @default(true) leads Lead[] auditLogs AuditLog[] @@unique([organizationId,email]) }
model Company { id String @id @default(uuid()) organizationId String organization Organization @relation(fields:[organizationId],references:[id]) prospectId String name String legalName String? country String @default("Saudi Arabia") city String? website String? industry String? businessType String? procurementCategory String? sourceUrl String? verification VerificationState @default(UNKNOWN) confidence Int? lastVerifiedAt DateTime? contacts Contact[] leads Lead[] intelligence IntelligenceItem[] opportunities Opportunity[] interests CustomerInterest[] createdAt DateTime @default(now()) @@unique([organizationId,prospectId]) @@index([organizationId,name]) }
model Contact { id String @id @default(uuid()) companyId String company Company @relation(fields:[companyId],references:[id],onDelete:Cascade) fullName String @default("UNKNOWN") position String? department String? email String? phone String? whatsapp String? linkedinUrl String? verification VerificationState @default(UNKNOWN) confidence Int? suppressedAt DateTime? suppressionReason String? messages Message[] }
model Lead { id String @id @default(uuid()) companyId String company Company @relation(fields:[companyId],references:[id]) ownerId String? owner User? @relation(fields:[ownerId],references:[id]) stage LeadStage @default(RESEARCH) priority String? score Int @default(0) scoreExplanation String? nextAction String? nextActionAt DateTime? createdAt DateTime @default(now()) }
model Commodity { id String @id @default(uuid()) name String @unique interests CustomerInterest[] opportunities Opportunity[] }
model CustomerInterest { companyId String company Company @relation(fields:[companyId],references:[id],onDelete:Cascade) commodityId String commodity Commodity @relation(fields:[commodityId],references:[id]) verification VerificationState @default(UNKNOWN) notes String? @@id([companyId,commodityId]) }
model IntelligenceItem { id String @id @default(uuid()) companyId String company Company @relation(fields:[companyId],references:[id],onDelete:Cascade) information String sourceUrl String? sourceType String? dateFound DateTime? verification VerificationState confidence Int? createdAt DateTime @default(now()) }
model Segment { id String @id @default(uuid()) name String filterDefinition Json active Boolean @default(true) }
model Campaign { id String @id @default(uuid()) organizationId String organization Organization @relation(fields:[organizationId],references:[id]) name String status String goal String? steps CampaignStep[] messages Message[] createdAt DateTime @default(now()) }
model CampaignStep { id String @id @default(uuid()) campaignId String campaign Campaign @relation(fields:[campaignId],references:[id],onDelete:Cascade) stepOrder Int channel String waitMinutes Int? configuration Json @@unique([campaignId,stepOrder]) }
model Message { id String @id @default(uuid()) campaignId String? campaign Campaign? @relation(fields:[campaignId],references:[id]) contactId String contact Contact @relation(fields:[contactId],references:[id]) channel String state MessageState @default(DRAFT) subject String? body String providerMessageId String? idempotencyKey String @unique scheduledAt DateTime? sentAt DateTime? deliveredAt DateTime? error String? createdAt DateTime @default(now()) }
model Followup { id String @id @default(uuid()) leadId String ownerId String? dueAt DateTime status String channel String? notes String? }
model Opportunity { id String @id @default(uuid()) companyId String company Company @relation(fields:[companyId],references:[id]) commodityId String? commodity Commodity? @relation(fields:[commodityId],references:[id]) name String estimatedQuantity Decimal? estimatedValue Decimal? currency String? stage String probability Int? expectedClose DateTime? nextAction String? createdAt DateTime @default(now()) }
model Automation { id String @id @default(uuid()) name String status String version Int @default(1) trigger Json actions Json createdAt DateTime @default(now()) }
model Integration { id String @id @default(uuid()) provider String status String encryptedCredentials Bytes? lastSyncAt DateTime? createdAt DateTime @default(now()) }
model AiGeneration { id String @id @default(uuid()) purpose String output String grounding Json status String createdAt DateTime @default(now()) }
model AuditLog { id BigInt @id @default(autoincrement()) userId String? user User? @relation(fields:[userId],references:[id]) action String objectType String objectId String? previousValue Json? newValue Json? ip String? userAgent String? createdAt DateTime @default(now()) @@index([objectType,objectId]) }
